@model MVC.Models.DTOs.ClienteDTO

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!--=============== REMIXICONS ===============-->
    <link href="https://cdn.jsdelivr.net/npm/remixicon@3.2.0/fonts/remixicon.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/remixicon/3.5.0/remixicon.css" crossorigin="" />
    <link rel="stylesheet" href="../css/style.css" />

    <title>Eliminar Cliente</title>
</head>
<body>
    <main>
        <div class="content">
            <div class="section-header">
                <h2>Eliminar cliente</h2>
            </div>

            <div class="search-filter">
                <input type="text" placeholder="Buscar por ID o Nombre" id="searchInput">
                <button class="btn yellow">Buscar</button>
            </div>

            <form asp-action="EliminarCliente" asp-route-id="@Model.Id" method="post" class="form">
                <!-- Campos del cliente -->
                <input asp-for="Id" placeholder="ID Cliente" disabled />
                <input asp-for="EstadoId" placeholder="ID Estado" disabled />

                <!-- Campos de la persona -->
                <input asp-for="Persona.Nombre" placeholder="Nombre" disabled />
                <input asp-for="Persona.Apellido" placeholder="Apellido" disabled />
                <input asp-for="Persona.Nro_Doc" placeholder="DNI" disabled />
                <input asp-for="Persona.Telefono" placeholder="Teléfono" disabled />
                <input asp-for="Persona.Direccion" placeholder="Dirección" disabled />
                <input asp-for="Persona.CiudadId" placeholder="Ciudad" disabled />
                <input asp-for="Persona.Email" placeholder="Email" disabled />

                <button type="submit" class="btn red">Eliminar</button>
                <a asp-action="ListaClientes" class="btn yellow">Cancelar</a>
            </form>
        </div>
    </main>

    <script src="../js/main.js"></script>
</body>
</html>
