@model MVC.Models.DTOs.ProveedorDTO

@{
    ViewData["Title"] = "Crear Proveedor";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!--=============== REMIXICONS ===============-->
    <link href="https://cdn.jsdelivr.net/npm/remixicon@3.2.0/fonts/remixicon.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/remixicon/3.5.0/remixicon.css" crossorigin="">
    <link rel="stylesheet" href="~/css/style.css">

    <title>@ViewData["Title"]</title>
</head>
<body>
    <main>
        <div class="content">
            <!-- Header de la sección -->
            <div class="section-header">
                <h2>Crear proveedor</h2>
            </div>

            <!-- Formulario para crear proveedores -->
            <form asp-action="CrearProveedor" method="post" class="form">
                <input asp-for="Nombre" type="text" placeholder="Nombre" required>
                <input asp-for="Telefono" type="text" placeholder="Teléfono" required>
                <input asp-for="Direccion" type="text" placeholder="Dirección" required>
                <button type="submit" class="btn yellow">Guardar</button>
            </form>
        </div>
    </main>

    <script src="~/js/main.js"></script>
</body>
</html>
