@model MVC.Models.DTOs.ProveedorDTO

@{
    ViewData["Title"] = "Eliminar Proveedor";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Eliminar Proveedor</title>
    <link rel="stylesheet" href="~/css/style.css" />
    <link href="https://cdn.jsdelivr.net/npm/remixicon@3.2.0/fonts/remixicon.css" rel="stylesheet">
</head>
<body>
    <main>
        <div class="content">
            <div class="section-header">
                <h2>Eliminar proveedor</h2>
            </div>

            <div class="form">
                <form asp-action="EliminarProveedor" method="post">
                    <input type="hidden" asp-for="Id" />
                    <input asp-for="Nombre" placeholder="Nombre" disabled />
                    <input asp-for="Telefono" placeholder="Teléfono" disabled />
                    <input asp-for="Direccion" placeholder="Dirección" disabled />
                    <input asp-for="Email" placeholder="Email" disabled />
                    <button type="submit" class="btn red">Eliminar</button>
                </form>
            </div>
        </div>
    </main>

    <script src="~/js/main.js"></script>
</body>
</html>
