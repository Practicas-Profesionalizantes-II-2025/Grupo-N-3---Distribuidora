@model List<MVC.Models.DTOs.ProveedorDTO>

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lista de Proveedores</title>

    <!-- REMIXICONS -->
    <link href="https://cdn.jsdelivr.net/npm/remixicon@3.2.0/fonts/remixicon.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/remixicon/3.5.0/remixicon.css" crossorigin="">

    <!-- CSS -->
    <link rel="stylesheet" href="/css/site.css">

    <style>
        .tabla-container {
            max-height: 500px;
            overflow-y: auto;
            border: 1px solid #ddd;
            border-radius: 8px;
        }

        .tabla-empleados thead {
            position: sticky;
            top: 0;
            background-color: #f5f5f5;
            z-index: 1;
        }

        .tabla-container::-webkit-scrollbar {
            width: 8px;
        }

        .tabla-container::-webkit-scrollbar-thumb {
            background-color: #888;
            border-radius: 4px;
        }

            .tabla-container::-webkit-scrollbar-thumb:hover {
                background-color: #555;
            }
    </style>
</head>
<body>
    <main class="container full-width">
        <h2 class="titulo">Lista de proveedores</h2>

        <!-- Filtro de búsqueda con crear -->
        <div class="search-filter">
            <input type="text" placeholder="Buscar por ID, CUIL/CUIT o Nombre" id="searchInput">
            <button class="btn yellow">Buscar</button>
            <a asp-controller="Proveedor" asp-action="crearProveedor" class="btn yellow">Crear proveedor</a>
        </div>

        <div class="tabla-container">
            <table class="tabla-empleados">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Nombre</th>
                        <th>Teléfono</th>
                        <th>Dirección</th>
                        <th>Email</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <td>@item.Nombre</td>
                            <td>@item.Telefono</td>
                            <td>@item.Direccion</td>
                            <td>@item.Email</td>
                            <td class="acciones">
                                <a asp-controller="Proveedor" asp-action="modificarProveedor" asp-route-id="@item.Id"
                                   class="btn-icon edit" title="Editar">
                                    <i class="ri-pencil-line"></i>
                                </a>

                                <a href="javascript:void(0);" class="btn-icon red-outline" title="Eliminar"
                                   onclick="eliminarProveedor(@item.Id)">
                                    <i class="ri-delete-bin-line"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </main>

    <script src="/js/site.js"></script>
    <script>
        function eliminarProveedor(id) {
            if (!confirm("¿Estás seguro de eliminar este proveedor?")) return;

            fetch(`/Proveedor/eliminarProveedor?id=${id}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' }
            })
            .then(response => {
                if (response.ok) {
                    location.reload();
                } else {
                    alert("Error al eliminar el proveedor");
                }
            })
            .catch(err => alert("Error al eliminar el proveedor"));
        }
    </script>
</body>
</html>
