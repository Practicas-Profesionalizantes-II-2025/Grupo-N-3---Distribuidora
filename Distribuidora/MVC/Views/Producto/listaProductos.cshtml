@model IEnumerable<MVC.Models.DTOs.ProductoDTO>

@{
    ViewData["Title"] = "Lista de productos";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!--=============== REMIXICONS ===============-->
    <link href="https://cdn.jsdelivr.net/npm/remixicon@3.2.0/fonts/remixicon.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/remixicon/3.5.0/remixicon.css" crossorigin="">
    <link rel="stylesheet" href="../css/style.css">

    <title>@ViewData["Title"]</title>
</head>
<body>
    <!--=============== CONTENIDO PRINCIPAL ===============-->
    <main class="container full-width">
        <h2 class="titulo">@ViewData["Title"]</h2>

        <!-- Filtro de búsqueda + Crear Producto -->
        <div class="search-filter">
            <form asp-action="listaProductos" method="get" class="search-form">
                <input type="text" name="searchString" placeholder="Buscar por ID, Nombre o Categoría" id="searchInput" />
                <button type="submit" class="btn yellow">Buscar</button>
            </form>
            <a asp-action="crearProducto" class="btn yellow">Crear producto</a>
        </div>

        <table class="tabla-empleados">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nombre producto</th>
                    <th>Proveedor</th>
                    <th>Categoría</th>
                    <th>Unidades</th>
                    <th>Precio venta</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var producto in Model)
                    {
                        <tr>
                            <td>@producto.Id</td>
                            <td>@producto.Nombre</td>
                            <td>@producto.ProveedorNombre</td> <!-- mostrar nombre legible -->
                            <td>@producto.CategoriaNombre</td> <!-- mostrar nombre legible -->
                            <td>@producto.UnidadesProducto</td>
                            <td>@producto.PrecioProducto.ToString("C")</td>
                            <td class="acciones">
                                <a asp-action="modificarProducto" asp-route-id="@producto.Id" class="btn-icon yellow-outline" title="Editar">
                                    <i class="ri-pencil-line"></i>
                                </a>
                                <a asp-action="eliminarProducto" asp-route-id="@producto.Id" class="btn-icon red-outline" title="Eliminar">
                                    <i class="ri-delete-bin-line"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7">No hay productos registrados.</td>
                    </tr>
                }
            </tbody>
        </table>
    </main>

    <!--=============== JS ===============-->
    <script src="../js/main.js"></script>
</body>
</html>
