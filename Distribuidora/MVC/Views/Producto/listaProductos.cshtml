@model IEnumerable<MVC.Models.DTOs.ProductoDTO>

@{
    ViewData["Title"] = "Lista de productos";
}

<!DOCTYPE html>
<html lang="es">
<main class="container full-width">
    <h2 class="titulo">Lista de productos</h2>

    <!-- Filtro de búsqueda + Crear Producto -->
    <div class="search-filter">
        <input type="text" placeholder="Buscar por ID, Nombre o Categoría" id="searchInput">
        <button class="btn yellow">Buscar</button>
        <a href="crearProducto.html" class="btn yellow">Crear producto</a>
    </div>

    <div class="tabla-container">
        <table class="tabla-empleados">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nombre producto</th>
                    <th>Proveedor</th>
                    <th>Categoría</th>
                    <th>Unidades</th>
                    <th>Precio costo</th>
                    <th>Precio venta</th>
                    <th>Acción</th> <!-- columna nueva -->
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>1</td>
                    <td>Coca Cola 1.5 ltrs</td>
                    <td>Entre copas</td>
                    <td>Bebida</td>
                    <td>120</td>
                    <td>$1.150</td>
                    <td>$1.950</td>
                    <td class="acciones">
                        <a href="modificarProducto.html" class="btn-icon edit"><i class="ri-pencil-line"></i></a>
                        <a href="#" class="btn-icon delete" onclick="confirmDelete(this)"><i class="ri-delete-bin-line"></i></a>
                    </td>
                </tr>

                <tr>
                    <td>2</td>
                    <td>Oreo</td>
                    <td>Arcor SRL</td>
                    <td>Masitas</td>
                    <td>80</td>
                    <td>$950</td>
                    <td>$1.200</td>
                    <td class="acciones">
                        <a href="modificarProducto.html" class="btn-icon edit"><i class="ri-pencil-line"></i></a>
                        <a href="#" class="btn-icon delete" onclick="confirmDelete(this)"><i class="ri-delete-bin-line"></i></a>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

</main>

<!-- Modal de Confirmación -->
<div id="deleteModal" class="modal">
    <div class="modal-content">
        <div class="modal-header">
            <i class="ri-alert-line" style="font-size: 2rem; color: #ff4d4d;"></i>
            <h3>Confirmar eliminación</h3>
        </div>
        <p>¿Estás seguro que deseas eliminar este producto?</p>
        <div class="modal-buttons">
            <button class="btn confirm" id="confirmBtn">Sí, eliminar</button>
            <button class="btn cancel" id="cancelBtn">Cancelar</button>
        </div>
    </div>
</div>


    <!--=============== JS ===============-->
    <script src="../js/main.js"></script>
</body>
</html>
