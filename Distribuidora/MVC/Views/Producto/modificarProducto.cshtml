@model MVC.Models.DTOs.ProductoEditarModel

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!--=============== REMIXICONS ===============-->
    <link href="https://cdn.jsdelivr.net/npm/remixicon@3.2.0/fonts/remixicon.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/remixicon/3.5.0/remixicon.css" crossorigin="">
    <link rel="stylesheet" href="~/css/style.css">

    <title>Modificar Producto</title>
</head>
<body>
    <main>
        <div class="content">
            <!-- Header de la sección -->
            <div class="section-header">
                <h2>Modificar producto</h2>
            </div>

            <!-- Formulario para crear o modificar productos -->
            <form asp-action="AccionModificarProducto" method="post" class="form">
                <input type="hidden" asp-for="Id" /> @* para hacer el put necesitamos el id asi que lo oculatmos *@
                <input type="text" name="Nombre" placeholder="@Model.Nombre" id="nombreApellido"> @* se podria poner value="@Model.Nombre" pero se borraria al escribir *@
                <input type="text" name="PrecioProducto" placeholder="@Model.PrecioProducto" id="nombreApellido">
                <input type="text" name="Stock" placeholder="@Model.Stock" id="ciudad">
                <input type="text" name="PrecioProducto" placeholder="@Model.PrecioProducto" id="PrecioProducto">
                <select asp-for="CategoriaId" class="form-control">
                    @foreach (var categoria in Model.Categorias)
                    {
                        <option name="CategoriaId" value="@categoria.Id" selected="@(categoria.Id == Model.CategoriaId)">
                            @categoria.Nombre
                        </option>
                    }
                </select>

                <select asp-for="ProveedorId" class="form-control">
                    @foreach (var proveedor in Model.Proveedores)
                    {
                        <option name="ProveedorId" value="@proveedor.Id" selected="@(proveedor.Id == Model.ProveedorId ? "selected" : "")">
                            @proveedor.Nombre
                        </option>
                    }
                </select>

                <!-- contenedor exclusivo para centrar -->
                <div class="form-buttons-wrapper">
                    <div class="form-buttons">
                        <button type="submit" class="btn yellow">Guardar</button>
                        <a href="listaProductos.html" class="btn back">Volver</a>
                    </div>
                </div>
            </form>
        </div>


    </main>

    <script src="~/js/main.js"></script>
</body>
</html>
