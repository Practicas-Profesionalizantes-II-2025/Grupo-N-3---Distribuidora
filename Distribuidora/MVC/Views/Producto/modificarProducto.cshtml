@model MVC.Models.DTOs.ProductoEditarModel

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!--=============== REMIXICONS ===============-->
    <link href="https://cdn.jsdelivr.net/npm/remixicon@3.2.0/fonts/remixicon.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/remixicon/3.5.0/remixicon.css" crossorigin="">
    <link rel="stylesheet" href="~/css/site.css">

    <title>Modificar producto</title>
</head>
<body>
    <main>
        <div class="content">
            <!-- Header de la sección -->
            <div class="section-header">
                <h2>Modificar producto</h2>
            </div>

            <!-- Formulario para crear o modificar productos -->
            <form asp-action="AccionModificarProducto" method="post" class="form">
                <input type="hidden" asp-for="Id" /> @* para hacer el put necesitamos el id asi que lo oculatmos *@
                <label>Nombre</label>
                <input type="text" name="Nombre" placeholder="@Model.Nombre" value="@Model.Nombre" id="nombreApellido">
                <label>Precio</label>
                <input type="text" name="PrecioProducto" placeholder="@Model.PrecioProducto" value="@Model.PrecioProducto" id="nombreApellido">
                <label>Stock</label>
                <input type="number" name="Stock" placeholder="@Model.Stock" value="@Model.Stock" id="Stock">
                <label>Categoria</label>
                <select asp-for="CategoriaId"
                        asp-items="@(new SelectList(Model.Categorias, "Id", "Nombre", Model.CategoriaId))"
                        class="form-control">
                </select>
                <label>Proveedor</label>
                <select asp-for="ProveedorId"
                        asp-items="@(new SelectList(Model.Proveedores, "Id", "Nombre", Model.ProveedorId))"
                        class="form-control">
                </select>



                <!-- contenedor exclusivo para centrar -->
                <div class="form-buttons-wrapper">
                    <div class="form-buttons">
                        <button type="submit" class="btn yellow">Guardar</button>
                        <a asp-action="listaProductos" class="btn back">Volver</a>
                    </div>
                </div>  
            </form>
        </div>


    </main>
    <!--=============== JS ===============-->
    <script src="~/js/site.js"></script>
</body>
</html>
