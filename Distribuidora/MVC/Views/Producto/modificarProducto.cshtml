@model MVC.Models.DTOs.ProductoDTO

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!--=============== REMIXICONS ===============-->
    <link href="https://cdn.jsdelivr.net/npm/remixicon@3.2.0/fonts/remixicon.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/remixicon/3.5.0/remixicon.css" crossorigin="">
    <link rel="stylesheet" href="~/css/style.css">

    <title>Modificar Producto</title>
</head>
<body>
    <main>
        <div class="content">
            <!-- Header de la sección -->
            <div class="section-header">
                <h2>Modificar producto</h2>
            </div>

            <!-- Formulario para crear o modificar productos -->
            <div class="form">
                <input type="text" placeholder="@Model.Nombre" id="nombreApellido">
@*              <input type="text" placeholder="@Model." id="ProveedorNombre">
                <input type="text" placeholder="@Model." id="direccion"> *@
                <input type="text" placeholder="@Model.PrecioProducto" id="PrecioProducto">
                <input type="text" placeholder="@Model.Stock" id="ciudad">
            </div>
        </div>

        <!-- contenedor exclusivo para centrar -->
        <div class="form-buttons-wrapper">
            <div class="form-buttons">
                <button class="btn yellow">Guardar</button>
                <a href="listaProductos.html" class="btn back">Volver</a>
            </div>
        </div>
        </div>

    </main>

    <script src="~/js/main.js"></script>
</body>
</html>
