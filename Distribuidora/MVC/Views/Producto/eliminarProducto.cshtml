@model MVC.Models.DTOs.ProductoDTO

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!--=============== REMIXICONS ===============-->
    <link href="https://cdn.jsdelivr.net/npm/remixicon@3.2.0/fonts/remixicon.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/remixicon/3.5.0/remixicon.css" crossorigin="">
    <link rel="stylesheet" href="~/css/style.css">

    <title>Eliminar Producto</title>
</head>
<body>
    <main>
        <div class="content">
            <!-- Header de la sección -->
            <div class="section-header">
                <h2>Eliminar producto</h2>
            </div>

            <!-- Formulario para mostrar y eliminar producto -->
            <form asp-action="eliminarProducto" asp-route-id="@Model.Id" method="post" class="form">
                <input asp-for="Nombre" class="form-control" placeholder="Nombre producto" disabled />
                <input asp-for="ProveedorId" class="form-control" placeholder="Proveedor" disabled />
                <input asp-for="CategoriaId" class="form-control" placeholder="Categoría" disabled />
                <input asp-for="PrecioProducto" class="form-control" placeholder="Precio venta" disabled />

                <button type="submit" class="btn red">Eliminar</button>
                <a asp-action="listaProductos" class="btn yellow">Cancelar</a>
            </form>
        </div>
    </main>

    <script src="~/js/main.js"></script>
</body>
</html>
