<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- REMIXICONS -->
    <link href="https://cdn.jsdelivr.net/npm/remixicon@3.5.0/fonts/remixicon.css" rel="stylesheet">

    <!-- CSS -->
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/css/style.css" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <title>@ViewData["Title"]</title>
</head>
<body>
    <!--=============== HEADER ===============-->
    <header class="header">
        <nav class="nav container">
            <div class="nav__menu" id="nav-menu">
                <ul class="nav__list">

                    <!--=============== Empleados ===============-->
                    <li class="dropdown__item">
                        <a href="/Empleados/listaEmpleados" class="nav__link">Empleados</a>
                    </li>

                    <!--=============== Clientes ===============-->
                    <li class="dropdown__item">
                        <a href="/Clientes/listaClientes" class="nav__link">Clientes</a>
                    </li>

                    <!--=============== Productos ===============-->
                    <li class="dropdown__item">
                        <a href="/Producto/listaProductos" class="nav__link">Productos</a>
                    </li>

                    <!--=============== Stock ===============-->
                    <li class="dropdown__item">
                        <a href="/Stock" class="nav__link">Stock</a>
                    </li>

                    <!--=============== Proveedores ===============-->
                    <li class="dropdown__item">
                        <a href="/Proveedor/listaProveedores" class="nav__link">Proveedores</a>
                    </li>

                    <!--=============== Distribuidores ===============-->
                    <li class="dropdown__item">
                        <a href="/Distribuidor/listaDistribuidores" class="nav__link">Distribuidores</a>
                    </li>

                    <!--=============== Compras ===============-->
                    <li class="dropdown__item">
                        <a href="/Compras" class="nav__link">Compras</a>
                    </li>

                    <!--=============== Ventas ===============-->
                    <li class="dropdown__item">
                        <a href="/Ventas" class="nav__link">Ventas</a>
                    </li>

                    <!--=============== Usuario / Cerrar Sesión ===============-->
                    <li class="dropdown__item user-dropdown">
                        <div class="nav__link">
                            <i class="ri-user-line"></i>
                        </div>
                        <ul class="dropdown__menu">
                            <li>
                                <a href="/Loggin" class="dropdown__link">
                                    <i class="ri-logout-box-line"></i> Salir
                                </a>
                            </li>
                        </ul>
                    </li>

                </ul>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!--=============== JS ===============-->
    <script>
        const navMenu = document.getElementById("nav-menu"),
              navToggle = document.getElementById("nav-toggle");

        if(navToggle){
            navToggle.addEventListener("click", () => {
                navMenu.classList.toggle("show-menu");
                navToggle.classList.toggle("show-icon");
            });
        }
    </script>
</body>
</html>
