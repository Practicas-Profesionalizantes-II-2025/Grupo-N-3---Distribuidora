@model List<MVC.Models.DTOs.CategoriaDTO>

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lista de categorías</title>

    <!--=============== REMIXICONS ===============-->
    <link href="https://cdn.jsdelivr.net/npm/remixicon@3.2.0/fonts/remixicon.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/remixicon/3.5.0/remixicon.css" crossorigin="">

    <!--=============== CSS ===============-->
    <link rel="stylesheet" href="/css/site.css">
</head>
<body>
    <main class="container full-width">
        <h2 class="titulo">Lista categoría</h2>

        <!-- Filtro de búsqueda con crear -->
        <div class="search-filter">
            <input type="text" placeholder="Buscar por ID, Nombre o Categoría" id="searchInput">
            <button class="btn yellow">Buscar</button>
            <a href="crearCategoria.html" class="btn yellow">Crear categoría</a>
        </div>

        <!-- Tabla -->
        <table class="tabla-empleados">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nombre categoría</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>1</td>
                    <td>Bebida</td>
                    <td class="acciones">
                        <a href="modificarCategoria.html?id=1" class="btn-icon yellow-outline" title="Editar">
                            <i class="ri-pencil-line"></i>
                        </a>
                        <a href="eliminarCategoria.html?id=1" class="btn-icon red-outline" title="Eliminar">
                            <i class="ri-delete-bin-line"></i>
                        </a>
                    </td>
                </tr>
                <tr>
                    <td>2</td>
                    <td>Limpieza</td>
                    <td class="acciones">
                        <a href="modificarCategoria.html?id=2" class="btn-icon yellow-outline" title="Editar">
                            <i class="ri-pencil-line"></i>
                        </a>
                        <a href="eliminarCategoria.html?id=2" class="btn-icon red-outline" title="Eliminar">
                            <i class="ri-delete-bin-line"></i>
                        </a>
                    </td>
                </tr>
                <tr>
                    <td>3</td>
                    <td>Masitas</td>
                    <td class="acciones">
                        <a href="modificarCategoria.html?id=3" class="btn-icon yellow-outline" title="Editar">
                            <i class="ri-pencil-line"></i>
                        </a>
                        <a href="eliminarCategoria.html?id=3" class="btn-icon red-outline" title="Eliminar">
                            <i class="ri-delete-bin-line"></i>
                        </a>
                    </td>
                </tr>
            </tbody>
        </table>

    </main>

    <!--=============== JS ===============-->
    <script src="/js/site.js"></script>
</body>
</html>
