@model List<MVC.Models.DTOs.CategoriaDTO>

@{
    ViewData["Title"] = "Eliminar Categoría";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Eliminar Categoría</title>
    <link rel="stylesheet" href="~/css/style.css" />
</head>
<body>
    <main>
        <div class="content">
            <div class="section-header">
                <h2>Eliminar categoría</h2>
            </div>

            @if (Model != null && Model.Count > 0)
            {
                <form asp-action="eliminarCategoria" method="post">
                    <div class="form">
                        <select name="id" id="categoriaSelect">
                            @foreach (var categoria in Model)
                            {
                                <option value="@categoria.Id">@categoria.Nombre</option>
                            }
                        </select>
                    </div>
                    <div class="form">
                        <button type="submit" class="btn red">Eliminar</button>
                    </div>
                </form>
            }
            else
            {
                <p>No hay categorías disponibles para eliminar.</p>
            }
        </div>
    </main>
</body>
</html>
