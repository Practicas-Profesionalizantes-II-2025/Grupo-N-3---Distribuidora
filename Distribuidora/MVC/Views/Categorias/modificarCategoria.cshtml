@model MVC.Models.DTOs.CategoriaDTO

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!--=============== REMIXICONS ===============-->
    <link href="https://cdn.jsdelivr.net/npm/remixicon@3.2.0/fonts/remixicon.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/remixicon/3.5.0/remixicon.css" crossorigin="">
    <link rel="stylesheet" href="~/css/site.css">

    <title>Modificar categoría</title>
</head>
<body>
    <main>
        <div class="content">
            <!-- Header de la sección -->
            <div class="section-header">
                <h2>Modificar categoría</h2>
            </div>

            <!-- Formulario -->
            <form asp-action="modificarCategoria" asp-controller="Categorias" method="post">
                <div class="form">
                    <input type="hidden" asp-for="Id" />
                    <input type="text" asp-for="Nombre" placeholder="Nombre categoría" class="input-text" />
                    <span asp-validation-for="Nombre" class="text-danger"></span>
                </div>

                <!-- Botones -->
                <div class="form-buttons-wrapper">
                    <div class="form-buttons">
                        <button type="submit" class="btn yellow">Guardar</button>
                        <a asp-action="listaCategorias" asp-controller="Categorias" class="btn back">Volver</a>
                    </div>
                </div>


            </form>
        </div>
    </main>

    <!--=============== JS ===============-->
    <script src="~/js/site.js"></script>
</body>
</html>
