@model MVC.Models.DTOs.CategoriaDTO

@{
    ViewData["Title"] = "Crear Categoria";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pagina Inicio - Categorías</title>
    <link rel="stylesheet" href="../css/style.css" />
</head>
<body>
    <main>
        <div class="content">
            <!-- Header de la sección -->
            <div class="section-header">
                <h2>Crear categoría</h2>
            </div>

            <!-- Formulario para crear categoría -->
            <form asp-action="crearCategoria" method="post" class="form">
                <input type="text" name="Nombre" placeholder="Nombre categoría" value="@Model?.Nombre">
                <button type="submit" class="btn yellow">Guardar</button>
            </form>

        </div>
    </main>
    <script src="~/js/main.js"></script>
</body>
</html>
