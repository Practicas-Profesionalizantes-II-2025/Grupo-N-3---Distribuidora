@model MVC.Models.DTOs.EmpleadoDTO

<main>
    <div class="content">
        <!-- Header de la sección -->
        <div class="section-header">
            <h2>Modificar empleado</h2>
        </div>

        <form asp-action="modificarEmpleado" method="post">
            <!-- Campos ocultos necesarios -->
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="Persona.Id" />
            <input type="hidden" asp-for="Persona.Tipo_DocId" />
            <input type="hidden" asp-for="Persona.Nro_Doc" />
            <input type="hidden" asp-for="Persona.CiudadId" />
            <input type="hidden" asp-for="EstadoId" />
            <input type="hidden" asp-for="Foto" />


            <div class="form">
                <!-- Nombre y apellido -->
                <input asp-for="Persona.Nombre" placeholder="Nombre" />
                <input asp-for="Persona.Apellido" placeholder="Apellido" />

                <!-- Tipo y número de documento -->
                <input asp-for="Persona.Nro_Doc" placeholder="Número de documento" readonly />

                <!-- Campo Teléfono -->
                <input asp-for="Persona.Telefono" placeholder="Número de teléfono" />

                <!-- Dirección -->
                <input asp-for="Persona.Direccion" placeholder="Dirección" />

                <!-- Ciudad -->
                <input asp-for="Persona.CiudadId" placeholder="Ciudad" />

                <!-- Email -->
                <input asp-for="Persona.Email" placeholder="Email" />

                 
                <!-- Cargo  <input asp-for="CargoId" placeholder="Cargo" /> -->

                <!-- Estado -->
                <input asp-for="EstadoId" placeholder="Estado" />
            </div>

            <!-- Botones -->
            <div class="form-buttons-wrapper">
                <div class="form-buttons">
                    <button type="submit" class="btn yellow">Guardar</button>
                    <a asp-controller="Empleados" asp-action="listaEmpleados" class="btn back">Volver</a>
                </div>
            </div>

            <!-- Mostrar errores de validación -->
            <div class="validation-summary">
                @foreach (var key in ViewData.ModelState.Keys)
                {
                    var errors = ViewData.ModelState[key].Errors;
                    foreach (var error in errors)
                    {
                        <div class="text-danger">@error.ErrorMessage</div>
                    }
                }
            </div>
        </form>
    </div>
</main>
