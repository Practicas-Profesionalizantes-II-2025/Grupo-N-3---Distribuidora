@model MVC.Models.DTOs.EmpleadoVista_CargarEmpleadoDTO

@{
    ViewData["Title"] = "Crear Empleado";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Crear Empleado</title>

    <!--=============== REMIXICONS ===============-->
    <link href="https://cdn.jsdelivr.net/npm/remixicon@3.2.0/fonts/remixicon.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css">
</head>
<body>
<main>
    <div class="content">
        <!-- Header de la sección -->
        <div class="section-header">
            <h2>Crear Empleado</h2>
        </div>
          
        <div asp-validation-summary="All" class="text-danger" style="margin-bottom:15px;"></div>
        <!-- Formulario -->
        <form asp-action="crearEmpleado" method="post">
            <div class="form">
                <!-- Nombre y Apellido -->
                    <input type="text" asp-for="empleado.Persona.Nombre" placeholder="Nombre" class="input-text" required />
                    <input type="text" asp-for="empleado.Persona.Apellido" placeholder="Apellido" class="input-text" required />


                <!-- Tipo y Número de Documento -->
                <select asp-for="empleado.Persona.Tipo_DocId" class="input-text"
                            asp-items="@(new SelectList(Model.tiposDocumentos, "Id", "NombreTipoDocumento"))" required>
                    <option value="">Seleccionar tipo documento</option>
                </select>

                    <input type="text" asp-for="empleado.Persona.Nro_Doc" placeholder="Número de documento" class="input-text" required />


                <!-- Teléfono -->
                    <input type="tel" asp-for="empleado.Persona.Telefono" placeholder="Número de teléfono" class="input-text" required />

                <!-- Dirección -->
                    <input type="text" asp-for="empleado.Persona.Direccion" placeholder="Dirección" class="input-text" required />

                <!-- Código Postal (opcional, no en DTO) -->
                    <input type="text" id="cp" placeholder="Código Postal" class="input-text" required />

                <!-- Ciudad -->
                <select asp-for="empleado.Persona.CiudadId" class="input-text"
                            asp-items="@(new SelectList(Model.ciudades, "Id", "Nombre"))" required>
                    <option value="">Seleccionar ciudad</option>
                </select>

                <!-- Email -->
                    <input type="email" asp-for="empleado.Persona.Email" placeholder="Email" class="input-text" required />

                <!-- Contrasenia -->
                    <input type="password" asp-for="empleado.Contrasenia" placeholder="Contrasenia" class="input-text" required />
                <input type="password" asp-for="empleado.ContraseniaConfimarcion" placeholder="Repetir Contrasenia" class="input-text" />
            </div>

            <!-- Botones -->
            <div class="form-buttons-wrapper">
                <div class="form-buttons">
                    <button type="submit" class="btn yellow">Guardar</button>
                    <a asp-action="listaEmpleados" asp-controller="Empleados" class="btn back">Volver</a>
                </div>
            </div>
        </form>
    </div>
</main>
    <!--=============== JS ===============-->
    <script src="~/js/site.js"></script>
</body>
</html>
