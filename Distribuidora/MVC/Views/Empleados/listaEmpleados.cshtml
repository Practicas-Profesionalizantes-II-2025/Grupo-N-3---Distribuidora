@model List<MVC.Models.DTOs.EmpleadoDTO>

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lista de Empleados</title>

    <!--=============== REMIXICONS ===============-->
    <link href="https://cdn.jsdelivr.net/npm/remixicon@3.2.0/fonts/remixicon.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/remixicon/3.5.0/remixicon.css" crossorigin="">

    <!--=============== CSS ===============-->
    <link rel="stylesheet" href="/css/site.css">

    <style>
        /* Contenedor scrollable */
        .tabla-container {
            max-height: 500px;
            overflow-y: auto;
            border: 1px solid #ddd;
            border-radius: 8px;
        }

        .tabla-empleados thead {
            position: sticky;
            top: 0;
            background-color: #f5f5f5;
            z-index: 1;
        }

        .tabla-container::-webkit-scrollbar {
            width: 8px;
        }

        .tabla-container::-webkit-scrollbar-thumb {
            background-color: #888;
            border-radius: 4px;
        }

        .tabla-container::-webkit-scrollbar-thumb:hover {
            background-color: #555;
        }
    </style>
</head>
<body>
    <main class="container full-width">
        <h2 class="titulo">Lista de empleados</h2>

        <!-- Filtro de búsqueda -->
        <div class="search-filter">
            <input type="text" placeholder="Buscar por ID, DNI o Nombre" id="searchInput">
            <button class="btn yellow">Buscar</button>
            <a asp-controller="Empleados" asp-action="crearEmpleado" class="btn green">Crear Empleado</a>
        </div>

        <!-- Contenedor scrollable -->
        <div class="tabla-container">
            <table class="tabla-empleados">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Nombre y Apellido</th>
                        <th>DNI</th>
                        <th>Teléfono</th>
                        <th>Dirección</th>
                        <th>Ciudad</th>
                        <th>Email</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var empleado in Model)
                    {
                        <tr>
                            <td>@empleado.Id</td>
                            <td>@empleado.Persona?.Nombre @empleado.Persona?.Apellido</td>
                            <td>@empleado.Persona?.Nro_Doc</td>
                            <td>@empleado.Persona?.Telefono</td>
                            <td>@empleado.Persona?.Direccion</td>
                            <td>@empleado.Persona?.CiudadId</td>
                            <td>@empleado.Persona?.Email</td>
                   <!--          <td></td> agregar sector-->
                            <td>@empleado.EstadoId</td>
                            <td class="acciones">
                                <a asp-controller="Empleados" asp-action="modificarEmpleado" asp-route-id="@empleado.Id"
                                   class="btn-icon yellow-outline" title="Editar">
                                    <i class="ri-pencil-line"></i>
                                </a>
                                <a asp-controller="Empleados" asp-action="eliminarEmpleado" asp-route-id="@empleado.Id"
                                   class="btn-icon red-outline" title="Eliminar">
                                    <i class="ri-delete-bin-line"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </main>

    <!--=============== JS ===============-->
    <script src="/js/site.js"></script>
</body>
</html>
