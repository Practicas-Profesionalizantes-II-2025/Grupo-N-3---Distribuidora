<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!--=============== REMIXICONS ===============-->
    <link href="https://cdn.jsdelivr.net/npm/remixicon@3.2.0/fonts/remixicon.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/remixicon/3.5.0/remixicon.css" crossorigin="">
    <link rel="stylesheet" href="../css/style.css">

    <title>Pagina Inicio - Empleados</title>
</head>
<body>
    <main>
        <div class="content">
            <!-- Header de la sección -->
            <div class="section-header">
                <h2>Modificar distribuidor</h2>
            </div>

            <!-- Formulario para modificar distribuidor -->
            <div class="form">
                <input type="text" placeholder="Nombre" id="nombre">
                <input type="text" placeholder="CUIL/CUIT" id="cuil" disabled> <!-- campo bloqueado -->
                <input type="text" placeholder="Teléfono" id="telefono">
                <input type="text" placeholder="Dirección" id="direccion">
                <input type="text" placeholder="Ciudad" id="ciudad">
                <input type="text" placeholder="Provincia" id="provincia">
                <input type="text" placeholder="Código Postal" id="codigoPostal">
            </div>

            <!-- contenedor exclusivo para centrar -->
            <div class="form-buttons-wrapper">
                <div class="form-buttons">
                    <button class="btn yellow">Guardar</button>
                    <a href="listaDistribuidores.html" class="btn back">Volver</a>
                </div>
            </div>
        </div>
    </main>
    <script href="../js/main.js"></script>
</body>
</html>
