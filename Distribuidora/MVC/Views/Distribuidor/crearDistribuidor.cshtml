@model MVC.Models.DTOs.DistribuidorDTO

@{
    ViewData["Title"] = "Crear Distribuidor";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Página Inicio - Distribuidores</title>

    <!--=============== REMIXICONS ===============-->
    <link href="https://cdn.jsdelivr.net/npm/remixicon@3.2.0/fonts/remixicon.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/remixicon/3.5.0/remixicon.css" crossorigin="">

    <!--=============== CSS ===============-->
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <!--=============== CONTENIDO PRINCIPAL ===============-->
    <main>
        <div class="content">
            <!-- Header de la sección -->
            <div class="section-header">
                <h2>Crear distribuidor</h2>
            </div>

            <!-- Formulario para crear distribuidor -->
            <form asp-controller="Distribuidor" asp-action="crearDistribuidor" method="post" class="form">
                <input type="text" asp-for="Nombre" placeholder="Nombre" required />
                <input type="text" asp-for="CuilCuit" placeholder="CUIL/CUIT" required />
                <input type="text" asp-for="Telefono" placeholder="Teléfono" required />
                <input type="text" asp-for="Direccion" placeholder="Dirección" required />
                <select asp-for="CiudadId" asp-items="@(new SelectList(Model.Ciudades, "Id", "Nombre"))" class="form-control" required>
                    <option value="">Seleccione ciudad</option>
                </select>

                <!-- contenedor exclusivo para centrar -->
                <div class="form-buttons-wrapper">
                    <div class="form-buttons">
                        <button type="submit" class="btn yellow">Guardar</button>
                        <a asp-controller="Distribuidor" asp-action="listaDistribuidores" class="btn back">Volver</a>
                    </div>
                </div>
            </form>
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <p>@error.ErrorMessage</p>
                    }
                </div>
            }
        </div>
    </main>

    <!--=============== JS ===============-->
    <script src="~/js/site.js"></script>
</body>
</html>
