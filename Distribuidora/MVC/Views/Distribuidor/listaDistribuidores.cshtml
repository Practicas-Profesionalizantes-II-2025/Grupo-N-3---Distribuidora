@{
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lista de distribuidores</title>

    <!--=============== REMIXICONS ===============-->
    <link href="https://cdn.jsdelivr.net/npm/remixicon@3.2.0/fonts/remixicon.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/remixicon/3.5.0/remixicon.css" crossorigin="">

    <!--=============== CSS ===============-->
    <link rel="stylesheet" href="~/css/site.css">
</head>
<body>
    <main class="container full-width">
        <h2 class="titulo">Lista de distribuidores</h2>

        <!-- Filtro de búsqueda con crear -->
        <div class="search-filter">
            <input type="text" placeholder="Buscar por ID, CUIL/CUIT o Nombre" id="searchInput">
            <button class="btn yellow">Buscar</button>
            <a asp-controller="Distribuidor" asp-action="crearDistribuidor" class="btn yellow">Crear Distribuidor</a>
        </div>

        <div class="tabla-container">
            <!-- Tabla -->
            <table class="tabla-empleados">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Nombre</th>
                        <th>CUIL/CUIT</th>
                        <th>Teléfono</th>
                        <th>Dirección</th>
                        <th>Ciudad</th>
                        <th>Provincia</th>
                        <th>Código Postal</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>1</td>
                        <td>Distribuidor A</td>
                        <td>20-12345678-9</td>
                        <td>3493-425869</td>
                        <td>Calle Falsa 123</td>
                        <td>Rosario</td>
                        <td>Santa Fe</td>
                        <td>2000</td>
                        <td class="acciones">
                            <a href="modificarDistribuidor.html" class="btn-icon edit"><i class="ri-pencil-line"></i></a>
                            <a href="#" class="btn-icon delete" title="Eliminar" onclick="confirmDelete(this)">
                                <i class="ri-delete-bin-line"></i>
                            </a>
                        </td>
                    </tr>
                    <tr>
                        <td>2</td>
                        <td>Distribuidor B</td>
                        <td>27-98765432-1</td>
                        <td>3492-693265</td>
                        <td>Avenida Siempre Viva 456</td>
                        <td>Santa Fe</td>
                        <td>Santa Fe</td>
                        <td>3000</td>
                        <td class="acciones">
                            <a href="modificarDistribuidor.html" class="btn-icon edit"><i class="ri-pencil-line"></i></a>
                            <a href="#" class="btn-icon delete" title="Eliminar" onclick="confirmDelete(this)">
                                <i class="ri-delete-bin-line"></i>
                            </a>
                        </td>
                    </tr>
                    <!-- Agregar más filas según necesidad -->
                </tbody>
            </table>
        </div>
    </main>

    <!-- Modal de Confirmación -->
    <div id="deleteModal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <i class="ri-alert-line" style="font-size: 2rem; color: #ff4d4d;"></i>
                <h3>Confirmar eliminación</h3>
            </div>
            <p>¿Estás seguro que deseas eliminar este distribuidor?</p>
            <div class="modal-buttons">
                <button class="btn confirm" id="confirmBtn">Sí, eliminar</button>
                <button class="btn cancel" id="cancelBtn">Cancelar</button>
            </div>
        </div>
    </div>

    <script>
        let rowToDelete = null;

        function confirmDelete(button) {
            rowToDelete = button.closest('tr');
            document.getElementById('deleteModal').style.display = 'flex';
        }

        document.getElementById('confirmBtn').onclick = function () {
            if (rowToDelete) {
                rowToDelete.remove();
                rowToDelete = null;
            }
            document.getElementById('deleteModal').style.display = 'none';
        }

        document.getElementById('cancelBtn').onclick = function () {
            rowToDelete = null;
            document.getElementById('deleteModal').style.display = 'none';
        }
    </script>

    <!--=============== JS ===============-->
    <script src="../js/main.js"></script>
</body>
</html>
