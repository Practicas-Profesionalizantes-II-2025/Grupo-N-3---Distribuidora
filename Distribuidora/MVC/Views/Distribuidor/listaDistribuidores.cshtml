@model List<MVC.Models.DTOs.DistribuidorDTO>

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lista de Distribuidores</title>

    <!-- REMIXICONS -->
    <link href="https://cdn.jsdelivr.net/npm/remixicon@3.2.0/fonts/remixicon.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/remixicon/3.5.0/remixicon.css" crossorigin="">

    <!-- CSS -->
    <link rel="stylesheet" href="/css/site.css">

    <style>
        .tabla-container {
            max-height: 500px;
            overflow-y: auto;
            border: 1px solid #ddd;
            border-radius: 8px;
        }

        .tabla-empleados thead {
            position: sticky;
            top: 0;
            background-color: #f5f5f5;
            z-index: 1;
        }

        .tabla-container::-webkit-scrollbar {
            width: 8px;
        }

        .tabla-container::-webkit-scrollbar-thumb {
            background-color: #888;
            border-radius: 4px;
        }

            .tabla-container::-webkit-scrollbar-thumb:hover {
                background-color: #555;
            }
    </style>
</head>
<body>
    <main class="container full-width">
        <h2 class="titulo">Lista de distribuidores</h2>

        <!-- Filtro de búsqueda con crear -->
        <div class="search-filter">
            <input type="text" placeholder="Buscar por ID, CUIL/CUIT o Nombre" id="searchInput">
            <button class="btn yellow">Buscar</button>
            <a asp-controller="Distribuidor" asp-action="crearDistribuidor" class="btn yellow">Crear distribuidor</a>
        </div>

        <div class="tabla-container">
            <table class="tabla-empleados">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Nombre</th>
                        <th>CUIL/CUIT</th>
                        <th>Teléfono</th>
                        <th>Dirección</th>
                        <th>Ciudad</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <td>@item.Nombre</td>
                            <td>@item.CuilCuit</td>
                            <td>@item.Telefono</td>
                            <td>@item.Direccion</td>
                            <td>@item.CiudadId</td>
                            <td class="acciones">
                                <a asp-controller="Distribuidor" asp-action="modificarDistribuidor" asp-route-id="@item.Id"
                                   class="btn-icon edit" title="Editar">
                                    <i class="ri-pencil-line"></i>
                                </a>

                                <a href="#" class="btn-icon red-outline" title="Eliminar" onclick="confirmDelete(this, @item.Id)">
                                    <i class="ri-delete-bin-line"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </main>

    <!-- Modal de Confirmación -->
    <div id="deleteModal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <i class="ri-alert-line" style="font-size: 2rem; color: #ff4d4d;"></i>
                <h3>Confirmar eliminación</h3>
            </div>
            <p>¿Estás seguro que deseas eliminar este distribuidor?</p>
            <div class="modal-buttons">
                <button class="btn confirm" id="confirmBtn">Sí, eliminar</button>
                <button class="btn cancel" id="cancelBtn">Cancelar</button>
            </div>
        </div>
    </div>

    <script>
        let distribuidorId = null;

        function confirmDelete(button, id) {
            distribuidorId = id;
            document.getElementById('deleteModal').style.display = 'flex';
        }

        document.getElementById('confirmBtn').onclick = function () {
            if (distribuidorId) {
                fetch(`/Distribuidor/eliminarDistribuidor?id=${distribuidorId}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' }
                })
                .then(response => {
                    if (response.ok) {
                        location.reload();
                    } else {
                        alert("Error al eliminar el distribuidor");
                    }
                })
                .catch(() => alert("Error al eliminar el distribuidor"));
            }
            document.getElementById('deleteModal').style.display = 'none';
        }

        document.getElementById('cancelBtn').onclick = function () {
            distribuidorId = null;
            document.getElementById('deleteModal').style.display = 'none';
        }
    </script>

    <script src="/js/site.js"></script>
</body>
</html>
