<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!--=============== REMIXICONS ===============-->
    <link href="https://cdn.jsdelivr.net/npm/remixicon@3.2.0/fonts/remixicon.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/remixicon/3.5.0/remixicon.css" crossorigin="">
    <link rel="stylesheet" href="../css/style.css">

    <title>Pagina Inicio - Empleados</title>
</head>
<body>
    <main>
        <div class="content">
            <!-- Header de la sección -->
            <div class="section-header">
                <h2>Crear empleado</h2>
            </div>

            <!-- Formulario para crear empleados -->
            <div class="form">
                <input type="text" placeholder="Nombre">
                <input type="text" placeholder="Apellido">

                <!-- Tipo y número de documento -->
                <select>
                    <option value="">Tipo de documento</option>
                    <option value="dni">DNI</option>
                    <option value="lc">LC</option>
                    <option value="le">LE</option>
                    <option value="pasaporte">Pasaporte</option>
                </select>
                <input type="text" placeholder="Número de documento">

                <!-- Campo Teléfono -->
                <input id="telefono" type="tel" placeholder="Número de teléfono">

                <input type="text" placeholder="Dirección">

                <!-- CP + ciudad -->
                <input type="text" id="cp" placeholder="Código Postal">
                <select id="ciudad">
                    <option value="">Seleccione ciudad</option>
                </select>

                <input type="email" placeholder="Email">
                <input type="text" placeholder="Cargo">

                <select>
                    <option value="">Estado</option>
                    <option value="dni">Activo</option>
                    <option value="lc">Inactivo</option>
                </select>

            </div>

            <!-- contenedor exclusivo para centrar -->
            <div class="form-buttons-wrapper">
                <div class="form-buttons">
                    <button class="btn yellow">Guardar</button>
                    <a href="listaEmpleados.html" class="btn back">Volver</a>
                </div>
            </div>
        </div>
    </main>

    <script href="../js/main.js"></script>
</body>
</html>