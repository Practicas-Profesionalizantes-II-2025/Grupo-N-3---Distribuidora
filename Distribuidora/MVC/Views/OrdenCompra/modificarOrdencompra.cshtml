@model MVC.Models.DTOs.OrdenDeCompraDTO

@{
    ViewData["Title"] = "Modificar Compra";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!--=============== REMIXICONS ===============-->
    <link href="https://cdn.jsdelivr.net/npm/remixicon@3.2.0/fonts/remixicon.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/remixicon/3.5.0/remixicon.css" crossorigin="">
    <link rel="stylesheet" href="~/css/style.css">

    <title>@ViewData["Title"]</title>
</head>
<body>
    <!--=============== MODIFICAR PEDIDO ===============-->
    <main class="pedido">
        <div class="section-header">
            <h2>Modificar compra</h2>
        </div>

        @using (Html.BeginForm("ModificarOrdenCompra", "OrdenCompra", FormMethod.Post, new { id = "pedidoForm" }))
        {
            <table class="pedido__table" id="pedidoTable">
                <thead>
                    <tr>
                        <th>ID Producto</th>
                        <th>Nombre</th>
                        <th>Cantidad</th>
                        <th>Precio Unitario</th>
                        <th>Total</th>
                        <th>Acción</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model?.ProductosSeleccionados != null && Model.ProductosSeleccionados.Any())
                    {
                        foreach (var prod in Model.ProductosSeleccionados)
                        {
                            <tr>
                                <td>
                                    <input type="text" name="id[]" value="@prod.ProductoId" readonly />
                                </td>
                                <td>
                                    <input type="text" name="nombre[]" value="@prod.NombreProducto" readonly />
                                </td>
                                <td>
                                    <input type="number" name="cantidad[]" value="@prod.CantidadProducto" min="1" class="cantidad" />
                                </td>
                                <td>
                                    <input type="number" name="precio[]" value="@prod.PrecioUnitario" step="0.01" class="precio" />
                                </td>
                                <td class="subtotal">
                                    @String.Format("{0:C}", prod.CantidadProducto * prod.PrecioUnitario)
                                </td>
                                <td>
                                    <button type="button" class="btn btn-delete">Eliminar</button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6">No hay productos en esta orden.</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="4" class="total-label">TOTAL:</td>
                        <td class="total-value" id="totalGeneral">
                            @String.Format("{0:C}", Model?.ProductosSeleccionados?.Sum(p => p.CantidadProducto * p.PrecioUnitario) ?? 0)
                        </td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>

            <div class="actions">
                <button type="button" class="btn" id="agregarFila">Agregar Producto</button>
                <button type="submit" class="btn">Guardar Cambios</button>
                <a asp-action="istaOrdenCompras" class="btn back">Volver</a>
            </div>
        }
    </main>

    <!--=============== JS ===============-->
    <script src="~/js/modificarPedido.js"></script>
</body>
</html>
