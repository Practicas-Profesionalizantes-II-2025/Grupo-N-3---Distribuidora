@model MVC.Models.DTOs.OrdenDeCompraDTO

@{
    ViewData["Title"] = "Crear Compra";
}

<main class="pedido container full-width">
    <div class="section-header">
        <h2>Crear Compra</h2>
    </div>

    @using (Html.BeginForm("crearOrdenCompra", "OrdenCompra", FormMethod.Post, new { id = "formOrden" }))
    {
        @Html.AntiForgeryToken()

        <!-- Datos generales -->
        <input type="hidden" asp-for="EmpleadoId" value="@Model.EmpleadoId" />
        <input type="hidden" asp-for="ProveedorId" value="@Model.ProveedorId" />
        <input type="hidden" asp-for="Estado" value="Pendiente" />
        <input type="hidden" asp-for="FechaOrden" value="@DateTime.Now" />

        <!-- Tabla de productos -->
        <table class="pedido__table" id="pedidoTable">
            <thead>
                <tr>
                    <th>Producto</th>
                    <th>Cantidad</th>
                    <th>Precio Unitario</th>
                    <th>Subtotal</th>
                    <th>Acción</th>
                </tr>
            </thead>
            <tbody>
                <!-- Filas se agregan dinámicamente -->
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="3" class="total-label">TOTAL:</td>
                    <td class="total-value" id="totalGeneral" style="text-align:right;">$0.00</td>
                    <td></td>
                </tr>
            </tfoot>
        </table>

        <!-- Container para inputs hidden de los productos -->
        <div id="productosContainer"></div>

        <div class="actions">
            <button type="button" class="btn" id="agregarFila">Agregar producto</button>
            <button type="submit" class="btn yellow">Confirmar Compra</button>
            <a asp-controller="OrdenCompra" asp-action="listaOrdenCompras" class="btn back">Volver</a>
        </div>
    }
  
</main>

@section Scripts {
    <script>
        const productos = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.Productos));
    </script>
    <script src="~/js/crearcompra.js"></script>
}
