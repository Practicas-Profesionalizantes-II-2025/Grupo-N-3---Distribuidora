@model MVC.Models.DTOs.OrdenDeVentaDTO

@{
    ViewData["Title"] = "Detalle Venta";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Detalle Venta</title>

    <!--=============== REMIXICONS ===============-->
    <link href="https://cdn.jsdelivr.net/npm/remixicon@3.2.0/fonts/remixicon.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css">
</head>
<body>
    <main class="pedido container full-width">
        <div class="section-header">
            <h2>Detalle Venta</h2>
        </div>

        <table class="pedido__table">
            <thead>
                <tr>
                    <th>ID Producto</th>
                    <th>Nombre</th>
                    <th>Cantidad</th>
                    <th>Precio Unitario</th>
                    <th>Total</th>
                </tr>
            </thead>
            <tbody>
             @*@if (Model.ProductosSeleccionados != null && Model.ProductosSeleccionados.Any())
                {
                    foreach (var p in Model.ProductosSeleccionados)
                    {
                        <tr>
                            <td>@p.ProductoId</td>
                            <td>@p.NombreProducto</td>
                            <td>@p.CantidadProducto</td>
                            <td>@p.PrecioUnitario.ToString("C")</td>
                            <td>@(p.PrecioUnitario* p.CantidadProducto).ToString("C")</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5">No hay productos en esta venta.</td>
                    </tr>
                }*@   
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="4" class="total-label">TOTAL:</td>
                    <td class="total-value">
                        @*@Model.ProductosSeleccionados?.Sum(p => p.PrecioUnitario * p.CantidadProducto).ToString("C") ?? "$0.00" *@    
                    </td>
                </tr>
            </tfoot>
        </table>

        <div class="actions">
            <a asp-controller="OrdenVenta" asp-action="listaVentas" class="btn back">Volver</a>
        </div>
    </main>

@section Scripts {
        <script src="~/js/site.js"></script>
}
</body>
</html>