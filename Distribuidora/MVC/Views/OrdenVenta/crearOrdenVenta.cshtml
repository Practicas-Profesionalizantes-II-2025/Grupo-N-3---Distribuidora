@model MVC.Models.DTOs.OrdenDeVentaDTO

@{
    ViewData["Title"] = "Crear Venta";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Crear Venta</title>

    <!--=============== REMIXICONS ===============-->
    <link href="https://cdn.jsdelivr.net/npm/remixicon@3.2.0/fonts/remixicon.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css">
</head>
<body>
    <main class="pedido container full-width">
        <div class="section-header">
            <h2>Crear Venta</h2>
        </div>

        @using (Html.BeginForm("crearOrdenVenta", "OrdenVenta", FormMethod.Post, new { id = "formVenta" }))
        {
            @Html.AntiForgeryToken()

            <!-- Datos generales ocultos -->
            <input type="hidden" asp-for="EmpleadoId" value="@Model.EmpleadoId" />
            <input type="hidden" asp-for="ClienteId" value="@Model.ClienteId" />
           <input type="hidden" asp-for="Estado" value="@Model.Estado" />
            <input type="hidden" asp-for="Fecha" value="@Model.Fecha" /> 

            <!-- Tabla de productos -->
            <table class="pedido__table" id="pedidoTable">
                <thead>
                    <tr>
                        <th>ID Producto</th>
                        <th>Nombre</th>
                        <th>Cantidad</th>
                        <th>Precio Unitario</th>
                        <th>Total</th>
                        <th>Acción</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Filas se agregarán dinámicamente desde JS -->
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="4" class="total-label">TOTAL:</td>
                        <td class="total-value" id="totalGeneral">$0.00</td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>

            <!-- Container para inputs hidden de productos seleccionados -->
            <div id="productosContainer"></div>

            <!-- Estado de la venta -->
            <div class="form-group">
                <label for="estadoVenta">Estado de la venta:</label>
                <select id="estadoVenta" name="Estado" class="input-select">
                    <option value="Pendiente" selected>Pendiente</option>
                    <option value="Enviado">Enviado</option>
                    <option value="Entregado">Entregado</option>
                </select>
            </div>

            <div class="actions">
                <button type="button" class="btn" id="agregarFila">Agregar producto</button>
                <button type="submit" class="btn">Confirmar Venta</button>
                <a asp-controller="OrdenVenta" asp-action="listaOrdenVentas" class="btn back">Volver</a>
            </div>
        }
    </main>

@section Scripts {
        <script>
            // Pasamos la lista de productos al JS
            const productos = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.Productos));
        </script>
        <script src="~/js/Venta/crearVenta.js"></script>
}
<</body>
</html>