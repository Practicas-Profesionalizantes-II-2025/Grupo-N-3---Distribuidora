@model MVC.Models.DTOs.OrdenDeVentaDTO

@{
    ViewData["Title"] = "Crear Venta";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Crear Venta</title>

    <!--=============== REMIXICONS ===============-->
    <link href="https://cdn.jsdelivr.net/npm/remixicon@3.2.0/fonts/remixicon.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css">
</head>
<body>
    <main class="pedido container full-width">
        <div class="section-header">
            <h2>Crear Venta</h2>
        </div>

        @using (Html.BeginForm("crearOrdenVenta", "OrdenVenta", FormMethod.Post, new { id = "formOrden" }))
        {
            @Html.AntiForgeryToken()

            <!-- Datos generales -->
            <input type="hidden" asp-for="EmpleadoId" value="@Model.EmpleadoId" />
            <input type="hidden" asp-for="ClienteId" value="@Model.ClienteId" />
            <input type="hidden" asp-for="Estado" value="Pendiente" />
            <input type="hidden" asp-for="Fecha" value="@DateTime.Now" />

            <!-- Tabla de productos -->
            <table class="pedido__table" id="pedidoTable">
                <thead>
                    <tr>
                        <th>Producto</th>
                        <th>Cantidad</th>
                        <th>Precio Unitario</th>
                        <th>Subtotal</th>
                        <th>Acción</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Filas se agregan dinámicamente -->
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="4" class="total-label">TOTAL:</td>
                        <td class="total-value" id="totalGeneral" style="text-align:right;">$0.00</td>
                    </tr>
                </tfoot>
            </table>

            <!-- Container para inputs hidden de los productos -->
            <div id="productosContainer"></div>

            <div class="actions">
                <button type="button" class="btn" id="agregarFila">Agregar producto</button>
                <button type="submit" class="btn yellow">Confirmar Venta</button>
                <a asp-controller="OrdenVenta" asp-action="listaOrdenVentas" class="btn back">Volver</a>
            </div>
        }

    </main>
</body>
</html>

@section Scripts {
    <script>
        const productos = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.Productos));
    </script>
    <script src="~/js/Venta/crearventa.js"></script>
}
