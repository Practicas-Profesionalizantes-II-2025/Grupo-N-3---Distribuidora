@model List<MVC.Models.DTOs.ClienteDTO>

@{
    ViewData["Title"] = "Eliminar Cliente";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Eliminar Cliente</title>
    <link rel="stylesheet" href="~/css/style.css" />
</head>
<body>
    <main>
        <div class="content">
            <div class="section-header">
                <h2>Eliminar cliente</h2>
            </div>

            @if (Model != null && Model.Count > 0)
            {
                <form asp-action="EliminarCliente" method="post">
                    <div class="form">
                        <select name="id" id="clienteSelect">
                            @foreach (var cliente in Model)
                            {
                                <option value="@cliente.Id">
                                    @cliente.Persona?.Nombre @cliente.Persona?.Apellido (@cliente.Id)
                                </option>
                            }
                        </select>
                    </div>
                    <div class="form">
                        <button type="submit" class="btn red">Eliminar</button>
                    </div>
                </form>
            }
            else
            {
                <p>No hay clientes disponibles para eliminar.</p>
            }
        </div>
    </main>
</body>
</html>
