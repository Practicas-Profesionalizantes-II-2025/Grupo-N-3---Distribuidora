@model MVC.Models.DTOs.ClienteDTO

@{
    ViewData["Title"] = "Crear Cliente";
}

<main>
    <div class="content">
        <!-- Header de la sección -->
        <div class="section-header">
            <h2>Crear Cliente</h2>
        </div>

        <!-- Formulario -->
        <form asp-action="crearCliente" method="post">
            <div class="form">
                <!-- Nombre y Apellido -->
                <input type="text" asp-for="Persona.Nombre" placeholder="Nombre" class="input-text" />
                <input type="text" asp-for="Persona.Apellido" placeholder="Apellido" class="input-text" />

                <!-- Tipo y Número de Documento -->
                <select asp-for="Persona.Tipo_DocId" asp-items="@(new SelectList(Model.Persona.TiposDocumentos, "Id", "NombreTipoDocumento"))" class="form-control">
                    <option value="">Seleccione tipo de documento</option>
                </select>

                <!-- Teléfono -->
                <input id="telefono" type="tel" asp-for="Persona.Telefono" placeholder="Número de teléfono" class="input-text" />

                <!-- Dirección -->
                <input type="text" asp-for="Persona.Direccion" placeholder="Dirección" class="input-text" />

                <!-- Código Postal (no está en el modelo, campo libre) -->
                <input type="text" id="cp" placeholder="Código Postal" class="input-text" />

                <!-- Ciudad -->
                <select asp-for="Persona.CiudadId" asp-items="@(new SelectList(Model.Persona.Ciudades, "Id", "Nombre"))" class="form-control">
                    <option value="">Seleccione ciudad</option>
                </select>

                <!-- Email -->
                <input type="email" asp-for="Persona.Email" placeholder="Email" class="input-text" />

                <!-- Estado (hidden, no editable) -->
                <input type="hidden" asp-for="EstadoId" value="1" />
            </div>

            <!-- Botones -->
            <div class="form-buttons-wrapper">
                <div class="form-buttons">
                    <button type="submit" class="btn yellow">Guardar</button>
                    <a asp-action="listaClientes" asp-controller="Clientes" class="btn back">Volver</a>
                </div>
            </div>
        </form>
    </div>
</main>
